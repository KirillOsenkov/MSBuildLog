<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".md" />
      <mimeMap fileExtension=".md" mimeType="text/markdown; charset=utf-8" />
    </staticContent>
    <rewrite>
      <rules>
        <rule name="Redirect mcp to binlogmcp" stopProcessing="true">
          <match url="^mcp/?$" />
          <action type="Redirect" url="/binlogmcp/" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
